{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Agent のエージェントの登録",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "coordinator": {
      "description": "進行役の GitHub App。段階の Issue の作成や親 Issue の Close など、振り分け用のワークフローの書き込みに使う",
      "type": "object",
      "properties": {
        "bot": { "$ref": "#/$defs/bot" },
        "appClientId": { "$ref": "#/$defs/appClientId" }
      },
      "required": ["bot", "appClientId"],
      "additionalProperties": false
    },
    "agents": {
      "description": "登録するエージェント。キーはエージェントの識別子",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,49}$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "roles": {
      "description": "段階ごとの担当",
      "type": "object",
      "properties": {
        "author": {
          "description": "段階ごとの作成担当",
          "type": "object",
          "properties": {
            "specification": { "$ref": "#/$defs/agentId" },
            "domain-model": { "$ref": "#/$defs/agentId" },
            "architecture": { "$ref": "#/$defs/agentId" },
            "planning": { "$ref": "#/$defs/agentId" }
          },
          "required": ["specification", "domain-model", "architecture", "planning"],
          "additionalProperties": false
        },
        "implementers": {
          "description": "実装計画で実装タスクに割り当ててよいエージェント",
          "type": "array",
          "items": { "$ref": "#/$defs/agentId" },
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewer": {
          "description": "レビュー担当",
          "$ref": "#/$defs/agentId"
        }
      },
      "required": ["author", "implementers", "reviewer"],
      "additionalProperties": false
    }
  },
  "required": ["coordinator", "agents", "roles"],
  "additionalProperties": false,
  "$defs": {
    "agentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,49}$"
    },
    "bot": {
      "description": "GitHub App の Bot 名 (<slug>[bot])",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\[bot\\]$"
    },
    "appClientId": {
      "description": "GitHub App の Client ID",
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "description": "表示名",
          "type": "string",
          "minLength": 1
        },
        "assignee": {
          "description": "Issue に Assign するアカウント (マシンユーザー) のログイン名",
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "bot": { "$ref": "#/$defs/bot" },
        "workflow": {
          "description": "エージェントを動かすワークフローのファイル名",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.ya?ml$"
        },
        "appClientId": { "$ref": "#/$defs/appClientId" },
        "model": {
          "description": "エージェントが使うモデル。null ならエージェントの既定",
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": ["name", "assignee", "bot", "workflow", "appClientId"],
      "additionalProperties": false
    }
  }
}
