{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "計画全体の概要 (Markdown)。実装計画の Issue へのコメントに使う"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,49}$",
            "description": "計画内で一意なタスクの識別子 (小文字英数字とハイフン)"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Issue のタイトル"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Issue の本文 (Markdown)。目的・作業内容・受け入れ条件を書く"
          },
          "agent": {
            "type": ["string", "null"],
            "description": "担当エージェントの識別子 (依頼の内容で示したもののどれか)。人が対応するタスクや、子タスクをまとめるだけのタスクは null"
          },
          "parent": {
            "type": ["string", "null"],
            "description": "親タスクの key。実装計画の Issue の直下に置く場合は null"
          },
          "blocked_by": {
            "type": "array",
            "items": { "type": "string" },
            "description": "このタスクより先に完了している必要があるタスクの key"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" },
            "description": "このタスクで受け入れテストを書いて通す、受け入れ基準の識別子 (例: AC12-3)。依頼の内容に書かれた識別子のすべてを、ちょうど 1 つのタスクに割り当てる。担当が null のタスクと、受け入れ基準が無い機能では、空の配列にする"
          }
        },
        "required": ["key", "title", "body", "agent", "parent", "blocked_by", "acceptance_criteria"],
        "additionalProperties": false
      }
    }
  },
  "required": ["summary", "tasks"],
  "additionalProperties": false
}
